{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Notepad",
  "version": "0.1.1",
  "identifier": "com.michel.codenotepad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Code Notepad",
        "width": 1320,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1421; font-src 'self' data:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; frame-src http: https: codenotepad: http://codenotepad.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "bash", "bat", "c", "cc", "cjs", "cmd", "cpp", "cs", "css", "cts", "cxx",
          "dart", "env", "go", "h", "hpp", "htm", "html", "ini", "java", "js", "json",
          "jsonc", "jsx", "kt", "kts", "less", "log", "lua", "markdown", "md", "mjs", "mts",
          "php", "phtml", "ps1", "py", "pyw", "rb", "rs", "scss", "sh", "sql", "svelte",
          "swift", "toml", "ts", "tsx", "txt", "vue", "xml", "yaml", "yml", "zsh"
        ],
        "name": "Code Notepad Source",
        "description": "Fichier de code ou de texte Code Notepad",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
